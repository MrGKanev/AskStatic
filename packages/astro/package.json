{
  "name": "astro-integration-askstatic",
  "version": "0.1.6",
  "description": "Static, model-free chat search for Astro sites: answers, clarifying questions and source links, generated at build time.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "astro-integration",
    "withastro",
    "astro-component",
    "search",
    "chat",
    "faq",
    "static",
    "pagefind",
    "a11y"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./component": "./component/AskStatic.astro",
    "./client": "./client/widget.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "component",
    "client",
    "src/core"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "node eval/run.ts en && node eval/run.ts bg"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "pagefind": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "pagefind": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "astro": "^7.3.8",
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrGKanev/AskStatic.git",
    "directory": "packages/astro"
  },
  "homepage": "https://github.com/MrGKanev/AskStatic#readme",
  "bugs": {
    "url": "https://github.com/MrGKanev/AskStatic/issues"
  },
  "author": "Gabriel Kanev"
}
