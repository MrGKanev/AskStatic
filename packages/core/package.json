{
  "name": "@mrgkanev/askstatic-core",
  "version": "0.1.0",
  "description": "Framework-agnostic engine for AskStatic: static, model-free question answering over build-time knowledge.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "node eval/run.ts en && node eval/run.ts bg"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrGKanev/AskStatic.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/MrGKanev/AskStatic#readme",
  "bugs": {
    "url": "https://github.com/MrGKanev/AskStatic/issues"
  },
  "author": "Gabriel Kanev"
}
