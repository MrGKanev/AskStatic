{
  "name": "askstatic-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "eval": "pnpm --filter astro-integration-askstatic eval",
    "e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "release": "pnpm build && pnpm --filter astro-integration-askstatic publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0"
  }
}
