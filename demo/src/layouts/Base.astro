---
import AskStatic from 'astro-integration-askstatic/component';
const { title, lang = 'en' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{title}</title></head>
  <body style="font-family: system-ui; max-width: 40rem; margin: 2rem auto; padding: 0 1rem">
    <nav><a href="/">EN</a> · <a href="/bg/">BG</a></nav>
    <main data-pagefind-body><slot /></main>
    <AskStatic />
  </body>
</html>
