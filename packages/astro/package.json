{
  "name": "astro-integration-askstatic",
  "version": "0.1.0",
  "description": "Static, model-free chat search for Astro sites: answers, clarifying questions and source links, generated at build time.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "astro-integration",
    "withastro",
    "astro-component",
    "search",
    "chat",
    "faq",
    "static",
    "pagefind",
    "a11y"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./component": "./component/AskStatic.astro",
    "./client": "./client/widget.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "component",
    "client"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@askstatic/core": "workspace:*",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "pagefind": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "pagefind": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "astro": "^7.3.8",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
